{
  "name": "mystery-prince",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs && node tools/serve.mjs",
    "preview": "node tools/serve.mjs",
    "test": "node --test verification/**/*.test.mjs",
    "test:browser": "node verification/browser/smoke.mjs",
    "verify": "npm run build && npm test && node tools/verify-release.mjs",
    "play": "node tools/play.mjs",
    "analyze": "node tools/analyze.mjs",
    "links": "node tools/links.mjs",
    "freeze:study": "node tools/freeze-study.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
