{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mp:inquiry-command:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "expectedRevision",
    "type",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "ask",
        "hypothesize",
        "close"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "roleId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
