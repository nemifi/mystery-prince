{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mp:publication:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "work",
    "editionId",
    "profile",
    "engine",
    "presenters",
    "hostContract",
    "permissions",
    "content",
    "assets",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "publication/1"
    },
    "id": {
      "type": "string",
      "pattern": "^pub_[a-f0-9]{64}$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "editionId": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "$ref": "#/$defs/implementation"
    },
    "hostContract": {
      "const": "session/1"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "digest",
          "mediaType",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[a-f0-9]{64}\\.[a-z0-9]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDigest",
        "builder"
      ],
      "properties": {
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "builder": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "presenters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/implementation"
      }
    }
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
